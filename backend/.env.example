# Définit la variable d’environnement NODE_ENV
NODE_ENV=development
# Définit la variable d’environnement PORT
PORT=3000
# Définit la variable d’environnement APP_VERSION
APP_VERSION=1.0.0
# Définit la variable d’environnement INSTANCE_NAME
INSTANCE_NAME=local
# Définit la variable d’environnement DB_HOST
DB_HOST=localhost
# Définit la variable d’environnement DB_PORT
DB_PORT=3306
# Définit la variable d’environnement DB_NAME
DB_NAME=scolarite
# Définit la variable d’environnement DB_USER
DB_USER=scolarite_user
# Définit la variable d’environnement DB_PASSWORD
DB_PASSWORD=
# Définit la variable d’environnement SESSION_SECRET
SESSION_SECRET=
# Définit la variable d’environnement STORAGE_DRIVER
STORAGE_DRIVER=local
# Définit la variable d’environnement UPLOAD_DIR
UPLOAD_DIR=uploads
# Définit la variable d’environnement AWS_REGION
AWS_REGION=
# Définit la variable d’environnement AWS_S3_BUCKET
AWS_S3_BUCKET=

# Commentaire: ligne de commentaire existante

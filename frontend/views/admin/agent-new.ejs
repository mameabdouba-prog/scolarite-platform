<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/head') %>
<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/sidebar') %>
<%# Commentaire: Exécute du code JavaScript EJS %>
<%
  <%# Commentaire: Contenu texte/template %>
  const v = (name) => (values && values[name] != null ? values[name] : '');
<%# Commentaire: Contenu texte/template %>
%>
<%# Commentaire: Ouvre/contient une balise HTML %>
<section class="page-head">
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div><h1 class="page-title">Créer un compte agent</h1><p class="page-subtitle">Les champs marqués d’un astérisque sont obligatoires. Ce formulaire est réservé aux administrateurs.</p></div>
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <a class="btn btn-secondary" href="/admin/agents"><%- icon('arrow-left') %> Liste des agents</a>
<%# Commentaire: Ferme une balise HTML %>
</section>
<%# Commentaire: Ouvre/contient une balise HTML %>
<section class="panel panel-narrow">
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div class="panel-head"><div><h3>Informations du compte</h3><p>Transmettez le mot de passe à l’agent par un canal sécurisé.</p></div></div>
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div class="panel-body">
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <form method="post" action="/admin/agents" class="form-grid">
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field"><label for="nom">Nom *</label><input id="nom" name="nom" value="<%= v('nom') %>" required></div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field"><label for="prenom">Prénom *</label><input id="prenom" name="prenom" value="<%= v('prenom') %>" required></div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field field-full"><label for="email">Adresse e-mail *</label><input id="email" name="email" type="email" value="<%= v('email') %>" required></div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field field-full"><label for="password">Mot de passe *</label><input id="password" name="password" type="password" placeholder="Au moins 8 caractères, une lettre et un chiffre" required></div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field-full form-actions">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <button class="btn btn-primary" type="submit">Créer le compte</button>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <a class="btn btn-secondary" href="/admin/agents">Annuler</a>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
    <%# Commentaire: Ferme une balise HTML %>
    </form>
  <%# Commentaire: Ferme une balise HTML %>
  </div>
<%# Commentaire: Ferme une balise HTML %>
</section>
<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/footer') %>

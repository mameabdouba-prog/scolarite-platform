<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/head') %>
<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/sidebar') %>
<%# Commentaire: Ouvre/contient une balise HTML %>
<section class="page-head">
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div>
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <h1 class="page-title">Détail de la demande</h1>
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <p class="page-subtitle">Dossier <span class="tabular"><%= dossier.reference_dossier %></span> · soumis le <%= formatDate(dossier.date_soumission) %> pour l’année <%= dossier.annee_universitaire %>.</p>
  <%# Commentaire: Ferme une balise HTML %>
  </div>
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div class="page-actions">
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <a class="btn btn-secondary" href="/etudiant/dossiers"><%- icon('arrow-left') %> Retour</a>
    <%# Commentaire: Condition EJS: affiche selon condition %>
    <% if (dossier.etat === 'VALIDE') { %>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <a class="btn btn-primary" href="/etudiant/dossiers/<%= dossier.id %>/attestation"><%- icon('download') %> Attestation</a>
    <%# Commentaire: Exécute du code JavaScript EJS %>
    <% } %>
  <%# Commentaire: Ferme une balise HTML %>
  </div>
<%# Commentaire: Ferme une balise HTML %>
</section>

<%# Commentaire: Ouvre/contient une balise HTML %>
<div class="panel-grid">
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <section class="panel">
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <div class="panel-head"><div><h3>Informations du dossier</h3></div><%- include('../partials/etatBadge', { etat: dossier.etat }) %></div>
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <div class="panel-body">
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <dl class="detail-grid">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div><dt>Référence</dt><dd class="tabular"><%= dossier.reference_dossier %></dd></div>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div><dt>Filière</dt><dd><%= dossier.filiere %></dd></div>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div><dt>Niveau</dt><dd><%= dossier.niveau %></dd></div>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div><dt>Année universitaire</dt><dd><%= dossier.annee_universitaire %></dd></div>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div><dt>Date de traitement</dt><dd><%= formatDate(dossier.date_traitement) %></dd></div>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div><dt>Dernière modification</dt><dd><%= formatDate(dossier.updated_at) %></dd></div>
      <%# Commentaire: Ferme une balise HTML %>
      </dl>
      <%# Commentaire: Condition EJS: affiche selon condition %>
      <% if (dossier.commentaire) { %>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div class="notice notice-info"><strong>Commentaire de l’agent</strong><p><%= dossier.commentaire %></p></div>
      <%# Commentaire: Exécute du code JavaScript EJS %>
      <% } %>
    <%# Commentaire: Ferme une balise HTML %>
    </div>
  <%# Commentaire: Ferme une balise HTML %>
  </section>

  <%# Commentaire: Ouvre/contient une balise HTML %>
  <section class="panel">
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <div class="panel-head"><div><h3>Pièces justificatives</h3><p><%= pieces.length %> pièce(s) sur <%= Object.keys(documentTypes).length %> requises.</p></div></div>
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <div class="panel-body">
      <%# Commentaire: Condition EJS: affiche selon condition %>
      <% if (!pieces.length) { %>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <p class="empty-line">Aucune pièce déposée.</p>
      <%# Commentaire: Branche alternative EJS %>
      <% } else { %>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div class="list">
          <%# Commentaire: Exécute du code JavaScript EJS %>
          <% pieces.forEach(function (piece) { %>
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <div class="list-row">
              <%# Commentaire: Ouvre/contient une balise HTML %>
              <div class="list-content"><strong><%= documentTypes[piece.type] || piece.type %></strong><small><%= piece.nom_original %> · <%= formatBytes(piece.taille) %></small></div>
              <%# Commentaire: Ouvre/contient une balise HTML %>
              <a class="btn btn-sm btn-secondary" href="/etudiant/pieces/<%= piece.id %>/download"><%- icon('download') %> Télécharger</a>
            <%# Commentaire: Ferme une balise HTML %>
            </div>
          <%# Commentaire: Boucle/fermeture de bloc EJS %>
          <% }); %>
        <%# Commentaire: Ferme une balise HTML %>
        </div>
      <%# Commentaire: Exécute du code JavaScript EJS %>
      <% } %>

      <%# Commentaire: Condition EJS: affiche selon condition %>
      <% if (dossier.etat === 'EN_ATTENTE') { %>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <form class="upload-zone" method="post" action="/etudiant/dossiers/<%= dossier.id %>/pieces?_csrf=<%= csrfParam %>" enctype="multipart/form-data">
          <%# Commentaire: Ouvre/contient une balise HTML %>
          <div class="field">
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <label for="type">Type de pièce</label>
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <select id="type" name="type" required>
              <%# Commentaire: Ouvre/contient une balise HTML %>
              <option value="">Sélectionner une pièce</option>
              <%# Commentaire: Exécute du code JavaScript EJS %>
              <% Object.keys(documentTypes).forEach(function (key) { %>
                <%# Commentaire: Condition EJS: affiche selon condition %>
                <% if (!pieces.some(function (p) { return p.type === key; })) { %>
                  <%# Commentaire: Ouvre/contient une balise HTML %>
                  <option value="<%= key %>"><%= documentTypes[key] %></option>
                <%# Commentaire: Exécute du code JavaScript EJS %>
                <% } %>
              <%# Commentaire: Boucle/fermeture de bloc EJS %>
              <% }); %>
            <%# Commentaire: Ferme une balise HTML %>
            </select>
          <%# Commentaire: Ferme une balise HTML %>
          </div>
          <%# Commentaire: Ouvre/contient une balise HTML %>
          <div class="field">
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <label for="piece">Fichier PDF ou JPG</label>
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <input id="piece" name="piece" type="file" accept=".pdf,.jpg,.jpeg,application/pdf,image/jpeg" required>
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <span class="help-text">Taille maximale : 5 Mo.</span>
          <%# Commentaire: Ferme une balise HTML %>
          </div>
          <%# Commentaire: Ouvre/contient une balise HTML %>
          <button class="btn btn-primary" type="submit"><%- icon('upload') %> Déposer la pièce</button>
        <%# Commentaire: Ferme une balise HTML %>
        </form>
      <%# Commentaire: Branche alternative EJS %>
      <% } else { %>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <div class="notice notice-info"><div>Le dossier est traité. Le dépôt de pièces est clos.</div></div>
      <%# Commentaire: Exécute du code JavaScript EJS %>
      <% } %>
    <%# Commentaire: Ferme une balise HTML %>
    </div>
  <%# Commentaire: Ferme une balise HTML %>
  </section>
<%# Commentaire: Ferme une balise HTML %>
</div>

<%# Commentaire: Ouvre/contient une balise HTML %>
<section class="panel">
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div class="panel-head"><div><h3>Historique du dossier</h3><p>Actions enregistrées sur cette demande</p></div></div>
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div class="panel-body">
    <%# Commentaire: Condition EJS: affiche selon condition %>
    <% if (!historique.length) { %><p class="empty-line">Aucune action enregistrée.</p><% } else { %>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <ul class="log-list">
        <%# Commentaire: Exécute du code JavaScript EJS %>
        <% historique.forEach(function (h) { %>
          <%# Commentaire: Ouvre/contient une balise HTML %>
          <li><span class="log-date"><%= formatDate(h.created_at) %></span><div class="log-body"><strong><%= h.action %></strong><p><%= h.description %></p><small><%= h.utilisateur_type %></small></div></li>
        <%# Commentaire: Boucle/fermeture de bloc EJS %>
        <% }); %>
      <%# Commentaire: Ferme une balise HTML %>
      </ul>
    <%# Commentaire: Exécute du code JavaScript EJS %>
    <% } %>
  <%# Commentaire: Ferme une balise HTML %>
  </div>
<%# Commentaire: Ferme une balise HTML %>
</section>
<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/footer') %>

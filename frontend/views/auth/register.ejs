<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/head') %>
<%# Commentaire: Exécute du code JavaScript EJS %>
<%
  <%# Commentaire: Contenu texte/template %>
  const v = (name) => (values && values[name] != null ? values[name] : '');
<%# Commentaire: Contenu texte/template %>
%>
<%# Commentaire: Ouvre/contient une balise HTML %>
<div class="auth-page">
  <%# Commentaire: Ouvre/contient une balise HTML %>
  <div class="auth-card auth-card-wide">
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <a class="auth-brand" href="/login">
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <span class="auth-brand-mark"><img src="/images/USSEIN-LOGO-copie.png" alt="Logo USSEIN"></span>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <span class="auth-brand-text"><strong>SCOLARITÉ</strong><small>USSEIN</small></span>
    <%# Commentaire: Ferme une balise HTML %>
    </a>
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <h1>Créer un compte étudiant</h1>
    <%# Commentaire: Ouvre/contient une balise HTML %>
    <p>Les champs marqués d’un astérisque sont obligatoires.</p>

    <%# Commentaire: Inclut un partial/template EJS %>
    <%- include('../partials/alerts') %>

    <%# Commentaire: Ouvre/contient une balise HTML %>
    <form method="post" action="/register" class="form-grid">
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <label for="numeroEtudiant">Numéro étudiant *</label>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <input id="numeroEtudiant" name="numeroEtudiant" value="<%= v('numeroEtudiant') %>" placeholder="Format : EX…" autocomplete="off" required>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <label for="email">Adresse e-mail *</label>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <input id="email" name="email" type="email" value="<%= v('email') %>" placeholder="Adresse e-mail" autocomplete="email" required>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <label for="nom">Nom *</label>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <input id="nom" name="nom" value="<%= v('nom') %>" placeholder="Nom de famille" autocomplete="family-name" required>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <label for="prenom">Prénom *</label>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <input id="prenom" name="prenom" value="<%= v('prenom') %>" placeholder="Prénom" autocomplete="given-name" required>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <label for="filiere">Filière *</label>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <select id="filiere" name="filiere" required>
          <%# Commentaire: Ouvre/contient une balise HTML %>
          <option value="">Sélectionner une filière</option>
          <%# Commentaire: Exécute du code JavaScript EJS %>
          <% filieres.forEach(function (f) { %>
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <option value="<%= f %>" <%= v('filiere') === f ? 'selected' : '' %>><%= f %></option>
          <%# Commentaire: Boucle/fermeture de bloc EJS %>
          <% }); %>
        <%# Commentaire: Ferme une balise HTML %>
        </select>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <label for="niveau">Niveau *</label>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <select id="niveau" name="niveau" required>
          <%# Commentaire: Ouvre/contient une balise HTML %>
          <option value="">Sélectionner un niveau</option>
          <%# Commentaire: Exécute du code JavaScript EJS %>
          <% niveaux.forEach(function (n) { %>
            <%# Commentaire: Ouvre/contient une balise HTML %>
            <option value="<%= n %>" <%= v('niveau') === n ? 'selected' : '' %>><%= n %></option>
          <%# Commentaire: Boucle/fermeture de bloc EJS %>
          <% }); %>
        <%# Commentaire: Ferme une balise HTML %>
        </select>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field field-full">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <label for="password">Mot de passe *</label>
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <input id="password" name="password" type="password" placeholder="Au moins 8 caractères, une lettre et un chiffre" autocomplete="new-password" required>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
      <%# Commentaire: Ouvre/contient une balise HTML %>
      <div class="field-full">
        <%# Commentaire: Ouvre/contient une balise HTML %>
        <button class="btn btn-primary btn-block" type="submit">Créer le compte</button>
      <%# Commentaire: Ferme une balise HTML %>
      </div>
    <%# Commentaire: Ferme une balise HTML %>
    </form>

    <%# Commentaire: Ouvre/contient une balise HTML %>
    <p class="auth-note">Déjà inscrit ? <a href="/login">Se connecter</a></p>
  <%# Commentaire: Ferme une balise HTML %>
  </div>
<%# Commentaire: Ferme une balise HTML %>
</div>
<%# Commentaire: Inclut un partial/template EJS %>
<%- include('../partials/authFooter') %>
